# Google AI Studio / Gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — one key for translation + cloud STT.
# Used as a fallback translator and optionally as a cloud ASR engine.
OPENROUTER_API_KEY=

# Models (can be changed without editing code)
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
GEMINI_SLIDE_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live

# OpenRouter models
OPENROUTER_TRANSLATE_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# auto | openrouter | gemini  (which translator is tried first; the other is fallback)
TRANSLATION_PROVIDER=auto

# whisper (local CPU) | openrouter (cloud STT — faster, needs OpenRouter credit)
ASR_PROVIDER=whisper

# Local whisper tuning: 0 = auto (all cores). Try 4 or 6 if the CPU is shared.
WHISPER_CPU_THREADS=0

# Drop oldest pending phrase if ASR falls behind (fast speaker), keeps it live.
MAX_PENDING_PHRASES=3

# --- Slide / blackboard capture ---
SLIDES_ENABLED=1
# auto | openrouter | tesseract | none  (auto = openrouter if key, else tesseract)
SLIDES_PROVIDER=auto
OPENROUTER_SLIDE_MODEL=google/gemini-2.5-flash-lite
SLIDES_MONITOR=1
SLIDES_SCAN_SECONDS=2.0
SLIDES_SETTLE_SECONDS=2.5
SLIDES_CHANGE_THRESHOLD=0.0015
SLIDES_MIN_INTERVAL_SECONDS=12.0
SLIDES_MAX_WIDTH=1280
SLIDES_DEDUP_RATIO=0.85
